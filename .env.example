# Copy to .env and adjust. Values match the code defaults, except OLLAMA_KEEP_ALIVE (recommended 30m).

# Ollama runs on the host, not in docker-compose.
# 127.0.0.1, not localhost: on Windows 'localhost' can add ~250 ms per request (IPv6 fallback).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.0
OLLAMA_KEEP_ALIVE=30m

# Resilience
OLLAMA_TIMEOUT_S=180
OLLAMA_CONNECT_TIMEOUT_S=5
OLLAMA_MAX_ATTEMPTS=3
OLLAMA_RETRY_INITIAL_WAIT_S=0.5
OLLAMA_RETRY_MAX_WAIT_S=8

# Structured output
# true  = pass the Pydantic JSON schema to Ollama (needs a recent Ollama)
# false = fall back to plain "json" mode on older Ollama versions
OLLAMA_USE_SCHEMA_FORMAT=true
STRUCTURED_MAX_REPAIRS=2

# Embeddings (ollama pull nomic-embed-text). Changing the model means changing EMBEDDING_DIM
# and re-ingesting with: python scripts/ingest.py <path> --reset
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=16

# Qdrant (docker compose up -d)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=documents
QDRANT_TIMEOUT_S=30

# Chunking / ingestion (sizes are estimated tokens, ~3.5 chars each)
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
INGEST_CONCURRENCY=2
INGEST_MAX_FILE_MB=5

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_PREFETCH_MULTIPLIER=4

# Agent (Phase 3)
RERANKER=flashrank                      # or: none
RERANK_MODEL=ms-marco-MiniLM-L-12-v2
RERANK_CACHE_DIR=data/models/flashrank
RETRIEVAL_CANDIDATES=20                 # hybrid candidates handed to the reranker
RERANK_TOP_N=5
RERANK_MIN_SCORE=0.25                   # below this the supervisor treats retrieval as weak
RERANK_MIN_PASSAGE_SCORE=0.001          # passages scoring below this are dropped before answering
GRAPH_MAX_STEPS=4
HISTORY_TURNS=4
SUPERVISOR_MAX_TOKENS=160
SUPERVISOR_MAX_REPAIRS=1
ANSWER_MAX_TOKENS=512
ANSWER_CONTEXT_TOKENS=1800              # answer_context + answer_max + 1200 must fit OLLAMA_NUM_CTX

# Tools (Phase 4)
CODE_WORKER_ENABLED=true
SANDBOX_IMAGE=python:3.12-slim          # docker pull python:3.12-slim
SANDBOX_TIMEOUT_S=15                    # whole `docker run`, including ~1 s start-up
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=1.0
SANDBOX_PIDS=64
SANDBOX_MAX_OUTPUT_CHARS=3000
CODE_MAX_TOKENS=400
CODE_MAX_REPAIRS=1
WEB_SEARCH_ENABLED=true                 # the search query leaves your machine when this runs
WEB_MAX_RESULTS=5
WEB_TIMEOUT_S=10

# Tracing (Phase 5): docker compose up -d phoenix, then open http://localhost:6006
TRACING_ENABLED=false
TRACING_ENDPOINT=http://127.0.0.1:6006/v1/traces
TRACING_PROJECT=agentic-rag
TRACING_CAPTURE_CONTENT=true            # false = record timings and counts but not prompt text

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# --- HTTP API (scripts/serve.py) ---
API_HOST=127.0.0.1
API_PORT=8000
API_KEY=                              # if set, send it as the X-API-Key header; required to bind off-loopback
API_CORS_ORIGINS=                     # comma-separated browser origins; empty = CORS off
API_UPLOAD_DIR=data/uploads
API_MAX_UPLOAD_MB=20
API_TURN_TIMEOUT_S=300
API_MAX_CONCURRENT_TURNS=1            # one CPU-bound model gains nothing from parallel turns
API_HEARTBEAT_S=5                     # SSE keep-alive; also how fast a disconnected client is noticed
